{
  "name": "tmpl_kmm",
  "source": "kmm.pdf",
  "sourceFonts": [
    "AAAAAC+Arial-BoldMT",
    "AAAAAE+ArialMT",
    "AAAAAF+ArialMT",
    "AAAAAH+Arial-ItalicMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.32,
    "columns": 2,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#d69d00",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/kmm.png",
    "align": "left"
  },
  "body": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 37,
      "weight": 700,
      "color": "#d69d00"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#002060"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#cccccc",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#002060",
    "zebra": false,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

{
  "name": "tmpl_sr",
  "source": "sr.pdf",
  "sourceFonts": [
    "AAAAAB+Verdana",
    "AAAAAC+Verdana-Bold",
    "AAAAAD+Verdana-BoldItalic",
    "AAAAAE+Arial-BoldMT",
    "AAAAAF+ArialMT",
    "AAAAAG+Arial-ItalicMT",
    "AAAAAH+Arial-BoldItalicMT"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.6,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "\"Verdana\", Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 16,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Verdana\", Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#e0e0e0",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

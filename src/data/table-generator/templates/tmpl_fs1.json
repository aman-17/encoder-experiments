{
  "name": "tmpl_fs1",
  "source": "fs1.pdf",
  "sourceFonts": [
    "AAAAAC+Apis-Regular",
    "AAAAAE+Apis-Bold",
    "AAAAAG+Apis-Regular"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#002d72",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 29,
      "weight": 700,
      "color": "#002d72"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#002d72"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#002d72",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#f0f0f0",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_lundy",
  "source": "lundy.pdf",
  "sourceFonts": [
    "AAAAAC+Optima-Regular",
    "AAAAAE+Calibri-Bold",
    "AAAAAG+Calibri",
    "AAAAAI+Calibri-Light",
    "AAAAAJ+Calibri-Light"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "center",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "\"Optima Regular\", Arial, Helvetica, sans-serif",
    "fontSizePx": 10,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 22,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 14,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 12,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Optima Regular\", Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#0088aa",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

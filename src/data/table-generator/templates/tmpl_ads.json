{
  "name": "tmpl_ads",
  "source": "ads.pdf",
  "sourceFonts": [
    "AAAAAC+TimesNewRomanPSMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.75,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 13,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 23,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 18,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 15,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#e6e6e6",
    "headerColor": "#000000",
    "zebra": true,
    "zebraColor": "#e6e6ff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

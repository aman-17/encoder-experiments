{
  "name": "tmpl_recc",
  "source": "recc.pdf",
  "sourceFonts": [
    "AAAAAC+Aptos-Narrow-Bold",
    "AAAAAE+Aptos-Narrow",
    "AAAAAG+Calibri-Bold",
    "AAAAAI+Calibri",
    "AAAAAJ+Calibri"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.51,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/recc.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 48,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

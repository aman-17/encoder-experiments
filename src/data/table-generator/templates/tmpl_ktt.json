{
  "name": "tmpl_ktt",
  "source": "ktt.pdf",
  "sourceFonts": [
    "AAAAAB+ArialMT",
    "AAAAAD+ArialMT",
    "AAAAAE+Arial-Black",
    "AAAAAG+Arial-Black",
    "AAAAAH+Arial-BoldMT",
    "AAAAAJ+Arial-BoldMT"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.39,
    "columns": 2,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#7f7f7f",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "center",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 49,
      "weight": 700,
      "color": "#7f7f7f"
    },
    "h2": {
      "fontSizePx": 18,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 15,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "none",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#a6a6a6",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

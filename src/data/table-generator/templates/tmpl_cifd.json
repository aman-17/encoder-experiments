  "sourceFonts": [
    "AAAAAB+HelveticaLTMM_334_1000",
    "AAAAAC+HelveticaLTMM_334_600",
    "AAAAAD+HelveticaLTMM_334_667",
    "AAAAAE+HelveticaLTMM_334_933",

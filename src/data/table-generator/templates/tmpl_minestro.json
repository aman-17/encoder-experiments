{
  "name": "tmpl_minestro",
  "source": "minestro.pdf",
  "sourceFonts": [
    "AAAAAB+Nexa-Bold",
    "AAAAAD+AvenirNext-DemiBold",
    "AAAAAF+AvenirNext-Italic",
    "AAAAAH+AvenirNext-Regular",
    "AAAAAI+AvenirNext-DemiBold",
    "AAAAAJ+AvenirNext-Regular",
    "AAAAAK+NexaRegular",
    "AAAAAM+AvenirNext-DemiBold"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/minestro.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 49,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 46,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 45,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 8,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#005696",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#e6f2f9",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_taski",
  "source": "taski.pdf",
  "sourceFonts": [
    "AAAAAB+FSAlbertPro",
    "AAAAAE+FSAlbertPro",
    "AAAAAC+FSAlbertPro-Bold",
    "AAAAAD+MonotypeSorts"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.01,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#333333",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/taski.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#333333"
  },
  "headings": {
    "h1": {
      "fontSizePx": 44,
      "weight": 700,
      "color": "#333333"
    },
    "h2": {
      "fontSizePx": 37,
      "weight": 700,
      "color": "#333333"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#333333"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "horizontal",
    "borderColor": "#e68a00",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#f7941e",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"
  }
}

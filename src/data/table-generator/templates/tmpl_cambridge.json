{
  "name": "tmpl_cambridge",
  "source": "cambridge.pdf",
  "sourceFonts": [
    "AAAAAB+BlissPro-Regular",
    "AAAAAC+BlissPro-Light",
    "AAAAAD+BlissPro-Bold",
    "AAAAAE+BlissPro-Regular",
    "AAAAAF+BlissPro-Medium",
    "AAAAAG+BlissPro-Medium",
    "AAAAAL+BlissPro-Bold",
    "AAAAAK+BlissPro-Bold"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.38,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#009688",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 46,
      "weight": 700,
      "color": "#009688"
    },
    "h2": {
      "fontSizePx": 43,
      "weight": 700,
      "color": "#ffffff"
    },
    "h3": {
      "fontSizePx": 39,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#cccccc",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#a8dcd9",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

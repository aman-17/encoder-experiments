{
  "name": "tmpl_mp",
  "source": "mp.pdf",
  "sourceFonts": [
    "AAAAAB+TradeGothic-BoldTwo",
    "AAAAAC+ZapfDingbatsITC",
    "AAAAAD+TradeGothic-Light",
    "AAAAAE+TradeGothic-Bold",
    "AAAAAF+TradeGothic-Light",
    "AAAAAG+TradeGothic-BoldTwo",
    "AAAAAH+TradeGothic-Light",
    "AAAAAI+ZapfDingbats"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 24,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 22,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#fcd000",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,

{
  "name": "tmpl_fstex",
  "source": "fstex.pdf",
  "sourceFonts": [
    "AAAAAC+TimesNewRomanPS-BoldMT",
    "AAAAAE+TimesNewRomanPSMT",
    "AAAAAG+Calibri"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.67,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 15,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#d3d3d3",
    "headerColor": "#8b0000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

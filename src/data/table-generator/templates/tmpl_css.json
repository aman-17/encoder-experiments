{
  "name": "tmpl_css",
  "source": "css.pdf",
  "sourceFonts": [
    "AAAAAB+NHaasGroteskDSPro-75Bd",
    "AAAAAC+NHaasGroteskDSPro-55Rg",
    "AAAAAD+NHaasGroteskDSPro-65Md",
    "AAAAAE+NHaasGroteskDSPro-95Blk",
    "AAAAAF+NHaasGroteskDSPro-56It"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.89,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#4d4d4d"
  },
  "headings": {
    "h1": {
      "fontSizePx": 26,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#005a8c"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#333333"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "horizontal",
    "borderColor": "#e0e0e0",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#005a8c",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#f5f5f5",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }

{
  "name": "tmpl_opa",
  "source": "opa.pdf",
  "sourceFonts": [
    "AAAAAC+Calibri-Bold",
    "AAAAAE+90possd"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.67,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.18,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/opa.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 11,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 13,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 10,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 8,
    "lineHeight": 1.15,
    "border": "header-only",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

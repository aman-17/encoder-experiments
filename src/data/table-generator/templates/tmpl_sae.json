{
  "name": "tmpl_sae",
  "source": "sae.pdf",
  "sourceFonts": [
    "AAAAAB+Helvetica",
    "AAAAAC+Helvetica-Bold"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.85,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 15,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 15,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 13,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 10,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#808080",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#d3d3d3",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

{
  "name": "tmpl_ns",
  "source": "ns.pdf",
  "sourceFonts": [
    "AAAAAC+Apis-Bold",
    "AAAAAE+Apis-Regular",
    "AAAAAG+Apis-Regular"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#002d72",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 20,
      "weight": 700,
      "color": "#002d72"
    },
    "h2": {
      "fontSizePx": 15,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 13,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 10,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#002d72",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#e6eef8",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

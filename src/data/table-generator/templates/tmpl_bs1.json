{
  "name": "tmpl_bs1",
  "source": "bs1.pdf",
  "sourceFonts": [
    "AAAAAB+ArialMT",
    "AAAAAC+Arial-ItalicMT",
    "AAAAAD+Futura-Medium",
    "AAAAAE+Arial-BoldMT",
    "AAAAAF+ArialMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/bs1.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 55,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 49,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "horizontal",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#a9a9a9",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

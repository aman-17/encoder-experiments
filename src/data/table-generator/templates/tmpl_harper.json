{
  "name": "tmpl_harper",
  "source": "harper.pdf",
  "sourceFonts": [
    "AAAAAB+CanvaSans-Bold"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "center",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/harper.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 27,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#ffffff"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#0056b3",
    "borderWidthPx": 2,
    "headerStyle": "band",
    "headerBg": "#5b9bd5",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_single",
  "source": "single.pdf",
  "sourceFonts": [
    "AAAAAB+AlrightSans-Medium",
    "AAAAAC+Whitman-RomanOsF",
    "AAAAAD+BlockGothicRR-LightExtraCond",
    "AAAAAE+AlrightSans-Regular",
    "AAAAAF+SourceSansPro-Bold",
    "AAAAAG+SourceSansPro-Regular"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.57,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 14,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 26,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 25,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 16,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#d1d1d1",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#739ac4",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"

{
  "name": "tmpl_sym",
  "source": "sym.pdf",
  "sourceFonts": [
    "AAAAAB+Helvetica",
    "AAAAAD+Arial-BoldMT",
    "AAAAAF+ArialMT",
    "AAAAAH+Arial-BoldItalicMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.44,
    "columns": 2,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.18,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "center",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 16,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 15,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

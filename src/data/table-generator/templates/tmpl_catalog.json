{
  "name": "tmpl_catalog",
  "source": "catalog.pdf",
  "sourceFonts": [
    "BBDZQV+DIN2014-Regular",
    "RMDRGP+DIN2014-Light",
    "IWNKKH+DIN2014-ExtraLight",
    "FUZSUN+MyriadPro-It",
    "EQPMGP+DIN2014-Demi",
    "XDDWMD+MyriadPro-Light",
    "NOYOCX+RobotoCondensed-Bold",
    "EYNMGP+RobotoCondensed-Regular"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.82,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#222222",
    "tint": "#b59b58",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#222222"
  },
  "headings": {
    "h1": {
      "fontSizePx": 90,
      "weight": 700,
      "color": "#222222"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#222222"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#222222"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "none",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#222222",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"
  }
}

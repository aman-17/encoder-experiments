{
  "name": "tmpl_basic",
  "source": "basic.pdf",
  "sourceFonts": [
    "AAAAAB+Helvetica",
    "AAAAAC+Arial-BoldMT",
    "AAAAAD+ArialMT",
    "AAAAAE+ArialMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.7,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 23,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 18,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 15,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

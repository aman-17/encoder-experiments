{
  "name": "tmpl_ttf",
  "source": "ttf.pdf",
  "sourceFonts": [
    "AAAAAC+FrutigerLTStd-Roman",
    "AAAAAD+MyriadPro-Regular",
    "AAAAAE+MyriadPro-Bold",
    "AAAAAF+Wingdings-Regular",
    "AAAAAG+Avenir-Heavy",
    "AAAAAH+Avenir-Roman",
    "AAAAAI+Avenir-Black"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/ttf.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 33,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#b22222",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "#ffffff",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "auto",
    "numericAlign": "right"
  }
}

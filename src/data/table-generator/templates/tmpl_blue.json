{
  "name": "tmpl_blue",
  "source": "blue.pdf",
  "sourceFonts": [
    "AAAAAB+BookAntiqua",
    "AAAAAC+TimesNewRomanPSMT",
    "AAAAAD+BookAntiqua-Italic"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.94,

{
  "name": "tmpl_uni",
  "source": "uni.pdf",
  "sourceFonts": [
    "AAAAAC+UnileverShilling",
    "AAAAAE+Calibri",
    "AAAAAG+UnileverShilling-Bd",
    "AAAAAH+SymbolMT",
    "AAAAAJ+ArialMT",
    "AAAAAL+UnileverShilling-It"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.47,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 27,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#ffffff",
    "headerColor": "#000000",
    "zebra": true,
    "zebraColor": "#e6f2ff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

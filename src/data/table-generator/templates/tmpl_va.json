{
  "name": "tmpl_va",
  "source": "va.pdf",
  "sourceFonts": [
    "AAAAAB+Arial-BoldMT",
    "AAAAAC+ArialMT",
    "AAAAAD+Arial-BoldMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.47,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#003399",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/va.png",
    "align": "left"
  },
  "body": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 36,
      "weight": 700,
      "color": "#003399"
    },
    "h2": {
      "fontSizePx": 24,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 18,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_td",
  "source": "td.pdf",
  "sourceFonts": [
    "AAAAAB+ArialMT",
    "AAAAAC+Helvetica",
    "AAAAAD+Times-BoldItalic",
    "AAAAAE+Times-Bold",
    "AAAAAF+Times-Roman",
    "AAAAAG+Arial-Black",
    "AAAAAI+Arial-BlackItalic",
    "AAAAAJ+Arial,Bold"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/td.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 127,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 125,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 120,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

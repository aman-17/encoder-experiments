{
  "name": "tmpl_bq",
  "source": "bq.pdf",
  "sourceFonts": [
    "AAAAAC+BLKFort-Extrabold",
    "AAAAAE+BLKFort-Book",
    "AAAAAF+BLKFort-Book",
    "AAAAAH+BLKFort-Bold"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ff4500",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/bq.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 35,
      "weight": 700,
      "color": "#ff4500"
    },
    "h2": {
      "fontSizePx": 29,
      "weight": 700,
      "color": "#ff4500"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#ff4500"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "horizontal",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

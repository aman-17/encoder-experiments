{
  "name": "tmpl_ded",
  "source": "ded.pdf",
  "sourceFonts": [
    "AAAAAC+Calibri",
    "AAAAAE+Calibri-Bold",
    "AAAAAF+SymbolMT",
    "AAAAAG+ArialMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.87,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#2f5496",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/ded.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#2f5496"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#2f5496"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#2f5496"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#2f5496",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#2f5496",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"
  }
}

{
  "name": "tmpl_lxc",
  "source": "lxc.pdf",
  "sourceFonts": [
    "AAAAAC+Calibri",
    "AAAAAE+Calibri-Bold",
    "AAAAAG+Aptos",
    "AAAAAI+Calibri-BoldItalic",
    "AAAAAJ+Calibri-Bold",
    "AAAAAK+Calibri"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.6,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 19,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 13,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 12,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#5b9bd5",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

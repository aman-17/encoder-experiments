{
  "name": "tmpl_pr",
  "source": "pr.pdf",
  "sourceFonts": [
    "AAAAAC+ArialNarrow-Bold",
    "AAAAAE+ArialNarrow",
    "AAAAAG+TimesNewRoman",
    "AAAAAH+font000000002fd04b84",
    "AAAAAJ+Arial"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 1.06,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#808080",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/pr.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 24,
      "weight": 700,
      "color": "#808080"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

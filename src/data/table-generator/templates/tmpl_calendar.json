{
  "name": "tmpl_calendar",
  "source": "calendar.pdf",
  "sourceFonts": [
    "AAAAAC+RobotoSlab-Regular",
    "AAAAAE+Roboto-Bold",
    "AAAAAG+Roboto-Regular",
    "AAAAAI+Calibri-Bold",
    "AAAAAK+ArialNarrow"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.71,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#666666",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/calendar.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 53,
      "weight": 700,
      "color": "#666666"
    },
    "h2": {
      "fontSizePx": 13,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 10,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 8,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#e0e0e0",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

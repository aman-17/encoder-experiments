{
  "name": "tmpl_wigram",
  "source": "wigram.pdf",
  "sourceFonts": [
    "AAAAAB+Karbon-Medium",
    "AAAAAC+Karbon-Semibold",
    "AAAAAD+Karbon-Regular",
    "AAAAAE+Karbon-Semibold",
    "AAAAAF+Karbon-Regular",
    "AAAAAG+Karbon-Medium",
    "AAAAAH+UniversLTStd-Cn"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.83,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#2c2a75",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 91,
      "weight": 700,
      "color": "#2c2a75"
    },
    "h2": {
      "fontSizePx": 28,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 21,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#d3d3d3",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#2c2a75",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#f0f4f8",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

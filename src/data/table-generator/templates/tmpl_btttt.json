{
  "name": "tmpl_btttt",
  "source": "btttt.pdf",
  "sourceFonts": [
    "AAAAAB+DIN2014-Bold",
    "AAAAAC+DIN2014-Regular",
    "AAAAAD+DIN2014-Bold",
    "AAAAAE+DIN2014-Regular",
    "AAAAAF+NeoSansW1G-Light"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/btttt.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 78,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 43,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 32,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "none",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

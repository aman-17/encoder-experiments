{
  "name": "tmpl_liverpool",
  "source": "liverpool.pdf",
  "sourceFonts": [
    "AAAAAB+FrutigerLTStd-BlackCn",
    "AAAAAC+FrutigerLTStd-Cn",
    "AAAAAD+FrutigerLTStd-LightCn",
    "AAAAAE+Futura-Book",
    "AAAAAF+Futura-Bold",
    "AAAAAG+FrutigerLTStd-BoldCn"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 14,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 24,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 22,
      "weight": 700,
      "color": "#ffffff"
    },
    "h3": {
      "fontSizePx": 16,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "none",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#333333",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#ffffcc",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

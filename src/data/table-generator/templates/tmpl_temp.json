{
  "name": "tmpl_temp",
  "source": "temp.pdf",
  "sourceFonts": [
    "AAAAAB+Calibri-Light",
    "AAAAAC+Calibri-Bold",
    "AAAAAD+Calibri"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.64,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#44546a",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 19,
      "weight": 700,
      "color": "#44546a"
    },
    "h2": {
      "fontSizePx": 12,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 10,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 8,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#4472c4",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#4472c4",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#fff2cc",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"
  }
}

{
  "name": "tmpl_liet",
  "source": "liet.pdf",
  "sourceFonts": [
    "AAAAAC+Calibri-Bold",
    "AAAAAD+Calibri",
    "AAAAAF+Calibri",
    "AAAAAH+Calibri-Light",
    "AAAAAI+Calibri-Light",
    "AAAAAJ+Calibri-LightItalic"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "justify",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 27,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#2f5496"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#bfbfbf",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

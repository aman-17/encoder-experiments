{
  "name": "tmpl_mex",
  "source": "mex.pdf",
  "sourceFonts": [
    "AAAAAC+TimesNewRoman",
    "AAAAAE+TimesNewRoman,Bold",
    "AAAAAG+Arial,Bold",
    "AAAAAI+Arial"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.01,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#0000ff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/mex.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 20,
      "weight": 700,
      "color": "#0000ff"
    },
    "h2": {
      "fontSizePx": 19,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#0000ff",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#d3d3d3",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

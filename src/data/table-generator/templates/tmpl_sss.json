{
  "name": "tmpl_sss",
  "source": "sss.pdf",
  "sourceFonts": [
    "AAAAAC+Calibri-Bold",
    "AAAAAE+Calibri",
    "AAAAAG+SegoeUI-Bold",
    "AAAAAI+SegoeUI",
    "AAAAAK+ArialMT",
    "AAAAAM+SegoeUI-BoldItalic",
    "AAAAAO+SegoeUI-Italic"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.73,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#4472c4",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 32,
      "weight": 700,
      "color": "#4472c4"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#d9d9d9",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"
  }
}

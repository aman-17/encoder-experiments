{
  "name": "tmpl_kfor",
  "source": "kfor.pdf",
  "sourceFonts": [
    "AAAAAB+ArialMT",
    "AAAAAD+OpenSans-Light",
    "AAAAAF+Calibri-Bold",
    "AAAAAH+Calibri-BoldItalic",
    "AAAAAI+TimesNewRomanPSMT",
    "AAAAAK+Calibri"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#003366",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 22,
      "weight": 700,
      "color": "#003366"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#003366"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#003366"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#003366",
    "borderWidthPx": 1,
    "headerStyle": "bold-line",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

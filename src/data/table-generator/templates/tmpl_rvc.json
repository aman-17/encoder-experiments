{
  "name": "tmpl_rvc",
  "source": "rvc.pdf",
  "sourceFonts": [
    "AAAAAB+Gotham-Bold",
    "AAAAAC+Gotham-Book",
    "AAAAAD+Gotham-Book"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.5,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#333333",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/rvc.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#333333"
  },
  "headings": {
    "h1": {
      "fontSizePx": 27,
      "weight": 700,
      "color": "#333333"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#333333"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#333333"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#999999",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#333333",
    "zebra": false,
    "zebraColor": "#f8f8f8",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

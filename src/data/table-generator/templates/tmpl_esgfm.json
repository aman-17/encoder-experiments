{
  "name": "tmpl_esgfm",
  "source": "esgfm.pdf",
  "sourceFonts": [
    "AAAAAC+VisaDialect-Light",
    "AAAAAE+VisaDialect-Semibold",
    "AAAAAG+VisaDialect-Regular"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.59,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#003399",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 29,
      "weight": 700,
      "color": "#003399"
    },
    "h2": {
      "fontSizePx": 15,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 13,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 10,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#003399",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#003399",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

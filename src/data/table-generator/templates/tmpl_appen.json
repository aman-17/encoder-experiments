{
  "name": "tmpl_appen",
  "source": "appen.pdf",
  "sourceFonts": [
    "AAAAAB+ArialMT",
    "AAAAAC+ArialMT",
    "AAAAAD+Arial-BoldMT",
    "AAAAAE+Arial-BoldMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.4,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "#000000",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#ffffff"
  },
  "headings": {
    "h1": {
      "fontSizePx": 42,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 24,
      "weight": 700,
      "color": "#00b7ef"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#ffffff"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#000000",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

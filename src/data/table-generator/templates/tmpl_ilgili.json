  "sourceFonts": [
    "AAAAAB+ArialNarrow",
    "AAAAAD+ArialNarrow",
    "AAAAAF+ArialNarrow-Bold",
    "AAAAAG+TimesNewRomanPSMT",
    "AAAAAH+TimesNewRomanPSMT",

    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#ffffff"
  },
  "headings": {
    "h1": {
      "fontSizePx": 74,

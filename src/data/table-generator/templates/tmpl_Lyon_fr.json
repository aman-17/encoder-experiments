{
  "name": "tmpl_Lyon_fr",
  "source": "Lyon_fr.pdf",
  "sourceFonts": [
    "WFJCGF+Roboto-Light",
    "WFJCGF+Roboto-Medium",
    "WFJCGF+Roboto-Black",
    "WFJCGF+Roboto-Light",
    "WFJCGF+Roboto-Medium",
    "WFJCGF+Roboto-Regular",
    "WFJCGF+Roboto-Bold",
    "WFJCGF+Roboto-Regular"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",

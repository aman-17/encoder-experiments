{
  "name": "tmpl_ambition",
  "source": "ambition.pdf",
  "sourceFonts": [
    "AAAAAC+Arial-BoldMT",
    "AAAAAE+ArialMT"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.78,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#00a3e0",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 24,
      "weight": 700,
      "color": "#00a3e0"
    },
    "h2": {
      "fontSizePx": 18,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 15,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "lineHeight": 1.3,
    "border": "none",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#d3eef8",
    "headerColor": "#00a3e0",
    "zebra": true,
    "zebraColor": "#e8e8e8",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

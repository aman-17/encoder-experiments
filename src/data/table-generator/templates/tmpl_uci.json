{
  "name": "tmpl_uci",
  "source": "uci.pdf",
  "sourceFonts": [
    "AAAAAB+Arial-BoldMT",
    "AAAAAC+TimesNewRomanPSMT",
    "AAAAAD+ArialMT"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.78,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/uci.png",
    "align": "left"
  },
  "body": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 14,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 24,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 20,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 18,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "#ffffff",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_canterbury",
  "source": "canterbury.pdf",
  "sourceFonts": [
    "AAAAAB+Frutiger-Light",
    "AAAAAC+Frutiger-Bold",
    "AAAAAD+Frutiger-Roman",
    "AAAAAF+Wingdings3",
    "AAAAAG+MapInfoMiscellaneous",
    "AAAAAH+MapInfoMiscellaneous"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.32,
    "columns": 2,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.18,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 14,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 64,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 62,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 58,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#005696",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#e0eaf2",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

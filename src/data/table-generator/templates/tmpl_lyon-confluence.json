{
  "name": "tmpl_lyon-confluence",
  "source": "lyon-confluence.pdf",
  "sourceFonts": [
    "NimbusSans-Regular",
    "NimbusSans-Bold",
    "DejaVuSans",
    "NimbusSans-Italic",
    "NimbusSans-BoldItalic",
    "DejaVuSans-Oblique"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#0070c0",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/lyon-confluence.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 18,
      "weight": 700,
      "color": "#0070c0"
    },
    "h2": {
      "fontSizePx": 13,
      "weight": 700,
      "color": "#0070c0"
    },
    "h3": {
      "fontSizePx": 10,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 8,
    "lineHeight": 1.3,
    "border": "none",
    "borderColor": "#cccccc",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"
  }
}

{
  "name": "tmpl_ge",
  "source": "ge.pdf",
  "sourceFonts": [
    "AAAAAC+HuaweiSans",
    "AAAAAE+HuaweiSansLight",
    "AAAAAG+HuaweiSans-Bold",
    "AAAAAI+HuaweiSans",
    "AAAAAJ+HuaweiSansLight"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.7,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "color": "#333333"
  },
  "headings": {
    "h1": {
      "fontSizePx": 19,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#ff0000"
    },
    "h3": {
      "fontSizePx": 15,
      "weight": 600,
      "color": "#333333"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#999999",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#808080",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#f0f0f0",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_mag",
  "source": "mag.pdf",
  "sourceFonts": [
    "AAAAAB+Ciutadella-Regular",
    "AAAAAC+Stag-Semibold",
    "AAAAAD+Calibri",
    "AAAAAF+Calibri-Bold",
    "AAAAAG+Calibri-Bold",
    "AAAAAH+font000000002fd02ec9",
    "AAAAAI+font000000002fd02ec9",
    "AAAAAJ+font000000002fd02ec9"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.38,
    "columns": 2,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#c0392b",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/mag.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 25,
      "weight": 700,
      "color": "#c0392b"
    },
    "h2": {
      "fontSizePx": 23,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#c0392b"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "horizontal",
    "borderColor": "#cccccc",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#f9f9f9",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

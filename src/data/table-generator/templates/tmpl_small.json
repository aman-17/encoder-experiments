{
  "name": "tmpl_small",
  "source": "small.pdf",
  "sourceFonts": [
    "AAAAAC+NotoSans-Regular",
    "AAAAAE+NotoSans-SemiBold",
    "AAAAAF+NotoSans-Bold",
    "AAAAAG+NotoSans-Regular",
    "AAAAAI+Overpass-Bold",
    "AAAAAK+NotoSans-Light",
    "AAAAAM+NotoSans-Light"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.7,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#004a99",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 40,
      "weight": 700,
      "color": "#004a99"
    },
    "h2": {
      "fontSizePx": 30,
      "weight": 700,
      "color": "#ff0000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "header-only",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

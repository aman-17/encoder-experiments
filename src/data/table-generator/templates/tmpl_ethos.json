{
  "name": "tmpl_ethos",
  "source": "ethos.pdf",
  "sourceFonts": [
    "AAAAAC+UniversLT",
    "AAAAAE+UniversLT-Light",
    "AAAAAF+GLYPHICONS-Regular"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.72,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#e30613",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/ethos.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 72,
      "weight": 700,
      "color": "#e30613"
    },
    "h2": {
      "fontSizePx": 62,
      "weight": 700,
      "color": "#e30613"
    },
    "h3": {
      "fontSizePx": 60,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#cccccc",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

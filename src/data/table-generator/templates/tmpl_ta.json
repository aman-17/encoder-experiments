{
  "name": "tmpl_ta",
  "source": "ta.pdf",
  "sourceFonts": [
    "AAAAAB+MetaNormal-Italic",
    "AAAAAC+MetaNormal-Roman",
    "AAAAAD+CharlotteBookPlain",
    "AAAAAE+CharlotteBookItalicPlain",
    "AAAAAF+MetaBold-Roman",
    "AAAAAH+Symbol"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.53,
    "columns": 2,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#d32f2f",
    "tint": "none",
    "bodyAlign": "justify",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 27,
      "weight": 700,
      "color": "#d32f2f"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#d32f2f"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#d32f2f"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

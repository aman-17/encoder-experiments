{
  "name": "tmpl_tsmq",
  "source": "tsmq.pdf",
  "sourceFonts": [
    "AAAAAC+TimesNewRomanPSMT",
    "AAAAAE+TimesNewRomanPS-BoldItalicMT",
    "AAAAAG+TimesNewRomanPS-BoldMT",
    "AAAAAI+Arial-BoldMT",
    "AAAAAK+ArialMT",
    "AAAAAL+SymbolMT"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.08,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/tsmq.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 23,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "box",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

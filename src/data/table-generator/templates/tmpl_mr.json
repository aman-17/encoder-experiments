{
  "name": "tmpl_mr",
  "source": "mr.pdf",
  "sourceFonts": [
    "AAAAAC+TrebuchetMS",
    "AAAAAE+TrebuchetMS-Bold",
    "AAAAAG+ArialMT",
    "AAAAAI+TrebuchetMS-Italic",
    "AAAAAK+Trebuchet-BoldItalic"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.48,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 19,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#a53f2a"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#a53f2a"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#a53f2a",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#f2dcd8",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

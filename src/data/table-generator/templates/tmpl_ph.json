      "weight": 700,
      "color": "#c5a45b"
    },
    "h3": {
      "fontSizePx": 15,
      "weight": 600,
      "color": "#c5a45b"
    }
  },
  "table": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#c5a45b",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#e8e1d1",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,

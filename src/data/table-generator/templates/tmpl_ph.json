{
  "name": "tmpl_ph",
  "source": "ph.pdf",
  "sourceFonts": [
    "AAAAAB+Sabon-BoldItalic",
    "AAAAAC+Sabon-Roman",
    "AAAAAD+Sabon-Bold",
    "AAAAAE+Sabon-Italic",
    "AAAAAF+Sabon-Roman",
    "AAAAAG+Sabon-BookItalic"

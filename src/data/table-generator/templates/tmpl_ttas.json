{
  "name": "tmpl_ttas",
  "source": "ttas.pdf",
  "sourceFonts": [
    "AAAAAB+DFKaiShu-SB-Estd-BF",
    "AAAAAD+DFKaiShu-SB-Estd-BF"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "center",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 14,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 19,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 20,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 16,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": true,
    "zebraColor": "#ffff99",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

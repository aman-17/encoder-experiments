{
  "name": "tmpl_ppt",
  "source": "ppt.pdf",
  "sourceFonts": [
    "AAAAAB+Helvetica",
    "AAAAAC+Helvetica-Bold",
    "AAAAAE+font000000002fd02f51"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.33,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/ppt.png",
    "align": "left"
  },
  "body": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 42,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "header-only",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

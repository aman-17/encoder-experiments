{
  "name": "tmpl_cfss",
  "source": "cfss.pdf",
  "sourceFonts": [
    "AAAAAC+Delivery-Regular",
    "AAAAAE+Delivery-Bold",
    "AAAAAF+Delivery-Regular"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.46,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#d40511",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 40,
      "weight": 700,
      "color": "#d40511"
    },
    "h2": {
      "fontSizePx": 33,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "none",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#000000",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

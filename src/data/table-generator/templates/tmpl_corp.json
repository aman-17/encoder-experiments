{
  "name": "tmpl_corp",
  "source": "corp.pdf",
  "sourceFonts": [
    "AAAAAC+VisaDialect-Light",
    "AAAAAE+VisaDialect-Semibold",
    "AAAAAG+VisaDialect-Regular",
    "AAAAAH+TimesNewRoman",
    "AAAAAJ+VisaDialect-Bold",
    "AAAAAL+VisaDialect-Medium",
    "AAAAAN+Times-Roman"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.59,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#0033cc",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 48,
      "weight": 700,
      "color": "#0033cc"
    },
    "h2": {
      "fontSizePx": 29,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 22,
      "weight": 600,
      "color": "#0033cc"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "lineHeight": 1.3,
    "border": "horizontal",
    "borderColor": "#cccccc",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#0033cc",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#f0f0f0",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",

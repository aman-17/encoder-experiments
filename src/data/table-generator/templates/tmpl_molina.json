{
  "name": "tmpl_molina",
  "source": "molina.pdf",
  "sourceFonts": [
    "AAAAAB+Calibri",
    "AAAAAC+Calibri-Bold"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.74,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#008fa1",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#008fa1"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#008fa1"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "horizontal",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#008fa1",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_juri",
  "source": "juri.pdf",
  "sourceFonts": [
    "AAAAAC+Aptos-Bold",
    "AAAAAE+Aptos",
    "AAAAAG+Aptos",
    "AAAAAI+Arial-BoldMT",
    "AAAAAK+AptosDisplay-Bold",
    "AAAAAM+AptosDisplay",
    "AAAAAO+Aptos-Bold",
    "AAAAAQ+Aptos-Bold"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.73,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/juri.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 26,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 23,
      "weight": 700,
      "color": "#008040"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#008040"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#008040",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"
  }
}

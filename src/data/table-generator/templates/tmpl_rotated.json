{
  "name": "tmpl_rotated",
  "source": "rotated.pdf",
  "sourceFonts": [
    "AAAAAB+Verdana-Bold",
    "AAAAAC+Verdana",
    "AAAAAD+KabelITCbyBT-Demi"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/rotated.png",
    "align": "left"
  },
  "body": {
    "fontStack": "\"Verdana Bold\", Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 62,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 57,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 55,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Verdana Bold\", Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#a32638",
    "headerColor": "#ffffff",
    "zebra": true,
    "zebraColor": "#e0e0e0",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_alko",
  "source": "alko.pdf",
  "sourceFonts": [
    "AAAAAB+ProximaNova-Bold",
    "AAAAAE+ProximaNova-Bold",
    "AAAAAC+ProximaNova-Regular",
    "AAAAAD+ProximaNova-Regular",
    "AAAAAF+ProximaNova-Light",
    "AAAAAG+ProximaNova-Light"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.55,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#58595b",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/alko.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#58595b"
  },
  "headings": {
    "h1": {
      "fontSizePx": 29,
      "weight": 700,
      "color": "#58595b"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#58595b"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#58595b"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#a7a9ac",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#ed1c24",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"
  }
}

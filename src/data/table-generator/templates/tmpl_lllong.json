{
  "name": "tmpl_lllong",
  "source": "lllong.pdf",
  "sourceFonts": [
    "AAAAAC+Arial-BoldItalicMT",
    "AAAAAE+ArialMT"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {

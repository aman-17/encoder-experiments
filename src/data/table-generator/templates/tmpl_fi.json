{
  "name": "tmpl_fi",
  "source": "fi.pdf",
  "sourceFonts": [
    "AAAAAC+TrebuchetMS",
    "AAAAAE+TrebuchetMS-Bold",
    "AAAAAG+ArialMT"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.48,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 22,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#a52a2a"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#cccccc",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#f0f0f0",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

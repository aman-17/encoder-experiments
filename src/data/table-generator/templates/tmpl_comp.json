{
  "name": "tmpl_comp",
  "source": "comp.pdf",
  "sourceFonts": [
    "AAAAAB+TimesNewRomanPS-BoldMT",
    "AAAAAC+TimesNewRomanPSMT",
    "AAAAAD+TimesNewRomanPSMT",
    "AAAAAE+TimesNewRomanPS-BoldMT",
    "AAAAAF+TimesNewRomanPS-ItalicMT",
    "AAAAAG+TimesNewRomanPS-BoldMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.7,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#003399",
    "tint": "none",
    "bodyAlign": "justify",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 22,
      "weight": 700,
      "color": "#003399"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 11,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#003399",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"

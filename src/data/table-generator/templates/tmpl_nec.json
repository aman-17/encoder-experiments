{
  "name": "tmpl_nec",
  "source": "nec.pdf",
  "sourceFonts": [
    "AAAAAC+TimesNewRomanPS-BoldMT",
    "AAAAAE+ArialNarrow-Bold",
    "AAAAAF+ArialNarrow-Bold",
    "AAAAAH+Calibri-Bold"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.72,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/nec.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 22,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#d3d3d3",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

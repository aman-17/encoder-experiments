{
  "name": "tmpl_cas",
  "source": "cas.pdf",
  "sourceFonts": [
    "AAAAAB+TransTextMd-Medium",
    "AAAAAC+TransTextMd-Medium",
    "AAAAAD+TransTextRm-Roman",
    "AAAAAE+TransTextMd-Medium",
    "AAAAAF+Frank-Bold",
    "AAAAAG+TransTextRm-Roman"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.4,
    "columns": 2,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 32,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 26,
      "weight": 700,
      "color": "#ffffff"
    },
    "h3": {
      "fontSizePx": 21,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#cccccc",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#e0e0e0",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

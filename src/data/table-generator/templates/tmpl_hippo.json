{
  "name": "tmpl_hippo",
  "source": "hippo.pdf",
  "sourceFonts": [
    "AAAAAC+Calibri",
    "AAAAAE+Barlow-Regular",
    "AAAAAG+BarlowCondensed-Bold",
    "AAAAAI+Barlow-Bold"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.7,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#009933",
    "tint": "#f2f2f2",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/hippo.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 26,
      "weight": 700,
      "color": "#009933"
    },
    "h2": {
      "fontSizePx": 18,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 15,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "bold-line",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": true,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

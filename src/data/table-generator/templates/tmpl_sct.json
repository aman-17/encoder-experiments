{
  "name": "tmpl_sct",
  "source": "sct.pdf",
  "sourceFonts": [
    "AAAAAB+Sabon-Roman",
    "AAAAAC+Sabon-Roman",
    "AAAAAD+Sabon-BoldItalic",
    "AAAAAE+Sabon-Bold",
    "AAAAAF+Sabon-ExtraBold"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.4,
    "columns": 2,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#c4a54c",
    "tint": "none",
    "bodyAlign": "justify",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 13,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 23,
      "weight": 700,
      "color": "#c4a54c"
    },
    "h2": {
      "fontSizePx": 18,
      "weight": 700,
      "color": "#c4a54c"
    },
    "h3": {
      "fontSizePx": 15,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Georgia, 'Times New Roman', serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#c4a54c",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#f4efe0",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

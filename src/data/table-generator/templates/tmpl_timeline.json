{
  "name": "tmpl_timeline",
  "source": "timeline.pdf",
  "sourceFonts": [
    "AAAAAC+Aptos-Bold",
    "AAAAAE+Aptos",
    "AAAAAG+Aptos",
    "AAAAAI+Arial-BoldMT",
    "AAAAAK+AptosDisplay-Bold",
    "AAAAAM+AptosDisplay"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/timeline.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 64,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 55,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 53,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#00678a",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"
  }
}

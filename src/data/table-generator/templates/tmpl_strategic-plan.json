{
  "name": "tmpl_strategic-plan",
  "source": "strategic-plan.pdf",
  "sourceFonts": [
    "NCIKMM+AzoSans-Bold",
    "NCIKMM+SourceSerifVariable-Roman",
    "NCIKMM+SourceSerifVariable-Italic",
    "NCIKMM+AzoSans-Regular",
    "JBUMIU+AzoSans-Light",
    "JBUMIU+AzoSans-Light",
    "JBUMIU+AzoSans-Light",
    "NCIKMM+SourceSerifVariable-Italic"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "#1a2a5a",
    "bodyAlign": "center",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#ffffff"
  },
  "headings": {
    "h1": {
      "fontSizePx": 27,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 21,

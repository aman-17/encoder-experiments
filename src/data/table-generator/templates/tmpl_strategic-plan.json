      "color": "#ffffff"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#ffffff"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "none",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "left"

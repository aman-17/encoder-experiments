{
  "name": "tmpl_waw",
  "source": "waw.pdf",
  "sourceFonts": [
    "AAAAAC+Calibri-Light",
    "AAAAAE+Calibri-Bold",
    "AAAAAG+Calibri"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "left",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 27,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 19,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#9dc3e6",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_luan",
  "source": "luan.pdf",
  "sourceFonts": [
    "AAAAAC+BrunelBoldPositive",
    "AAAAAE+BrunelBoldPositive",
    "AAAAAF+KozMinPro-Bold",
    "AAAAAH+BrunelPositive",
    "AAAAAJ+BrunelPositive"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.33,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ffffff",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.18,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "center",
      "upper": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 37,
      "weight": 700,
      "color": "#ffffff"
    },
    "h2": {
      "fontSizePx": 30,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 14,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 8,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#000000",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,

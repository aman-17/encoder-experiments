{
  "name": "tmpl_zurich",
  "source": "zurich.pdf",
  "sourceFonts": [
    "AAAAAB+DINPro-Bold",
    "AAAAAC+DINPro-Bold",
    "AAAAAD+DINPro",
    "AAAAAE+SBBPictoKubus"
  ],
  "page": {
    "size": "A4",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#003366",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 91,
      "weight": 700,
      "color": "#003366"
    },
    "h2": {
      "fontSizePx": 38,
      "weight": 700,
      "color": "#ffffff"
    },
    "h3": {
      "fontSizePx": 30,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "horizontal",
    "borderColor": "#cccccc",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#ffcc00",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_topleft",
  "source": "topleft.pdf",
  "sourceFonts": [
    "AAAAAC+FranklinGothic-Book",
    "AAAAAE+FranklinGothic-Medium"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#333333",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/topleft.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 36,
      "weight": 700,
      "color": "#333333"
    },
    "h2": {
      "fontSizePx": 21,
      "weight": 700,
      "color": "#333333"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#333333"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#e0efff",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

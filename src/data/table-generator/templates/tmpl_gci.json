{
  "name": "tmpl_gci",
  "source": "gci.pdf",
  "sourceFonts": [
    "AAAAAC+Arial-BoldMT",
    "AAAAAE+ArialMT",
    "AAAAAG+Arial-BoldItalicMT",
    "AAAAAI+Arial-ItalicMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 1.13,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/gci.png",
    "align": "left"
  },
  "body": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 20,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 11,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 10,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "\"Arial BoldMT\", Arial, Helvetica, sans-serif",
    "fontSizePx": 8,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#000000",
    "headerColor": "#ffffff",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

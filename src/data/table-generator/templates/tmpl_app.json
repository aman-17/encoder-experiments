{
  "name": "tmpl_app",
  "source": "app.pdf",
  "sourceFonts": [
    "AAAAAC+Overpass-SemiBold",
    "AAAAAD+NotoSans-SemiBold",
    "AAAAAE+NotoSans-Bold",
    "AAAAAG+NotoSans-Regular",
    "AAAAAI+NotoSans-SemiBold",
    "AAAAAJ+NotoSans-Regular",
    "AAAAAL+NotoSans-Light",
    "AAAAAN+NotoSans-Light"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#ff0000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 15,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 40,
      "weight": 700,
      "color": "#ff0000"
    },
    "h2": {
      "fontSizePx": 25,
      "weight": 700,
      "color": "#1a3c5e"
    },
    "h3": {
      "fontSizePx": 17,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.3,
    "border": "horizontal",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

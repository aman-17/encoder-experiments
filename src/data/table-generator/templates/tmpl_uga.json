{
  "name": "tmpl_uga",
  "source": "uga.pdf",
  "sourceFonts": [
    "AAAAAC+FranklinGothic-Book",
    "AAAAAE+FranklinGothic-Medium",
    "AAAAAF+Wingdings-Regular",
    "AAAAAH+FranklinGothic-MediumCond",
    "AAAAAJ+Calibri-Bold",
    "AAAAAL+Calibri"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "right",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/uga.png",
    "align": "left"
  },
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 14,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 54,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 42,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 16,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#c6d9f1",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

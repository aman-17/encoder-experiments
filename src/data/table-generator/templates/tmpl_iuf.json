{
  "name": "tmpl_iuf",
  "source": "iuf.pdf",
  "sourceFonts": [
    "AAAAAC+Calibri-Bold",
    "AAAAAE+Calibri",
    "AAAAAF+Calibri"
  ],
  "page": {
    "size": "A4",
    "marginIn": 1.07,
    "columns": 1,
    "orientation": "landscape"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 13,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 23,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 18,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 15,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#d9d9d9",
    "headerColor": "#000000",
    "zebra": true,
    "zebraColor": "#f2f2f2",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_wow",
  "source": "wow.pdf",
  "sourceFonts": [
    "AAAAAB+Calibri-Bold",
    "AAAAAC+Calibri"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 1.2,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 10,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 18,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 14,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 12,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "lineHeight": 1.3,
    "border": "none",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 8,
    "cellPadYPx": 4,
    "width": "100%",
    "numericAlign": "right"
  }
}

{
  "name": "tmpl_code-sheet",
  "source": "code-sheet.pdf",
  "sourceFonts": [
    "TKELIR+Arial,Bold",
    "PUZFJJ+Arial",
    "WKYNEU+Arial",
    "PUZFJJ+Arial",
    "PGWBHI+Arial,Bold",
    "TUWKXW+ArialMT",
    "BOMVTK+Arial,Bold",
    "EXVUBF+ArialMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.3,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.18,
    "letterSpacingPx": 0,
    "header": {
      "show": true,
      "rule": true,
      "align": "right",
      "upper": false
    },
    "footer": {
      "show": false
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 12,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 64,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 43,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 42,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "lineHeight": 1.15,
    "border": "grid",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "band",
    "headerBg": "#e0e0e0",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

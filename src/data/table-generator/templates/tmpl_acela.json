{
  "name": "tmpl_acela",
  "source": "acela.pdf",
  "sourceFonts": [
    "AAAAAB+Helvetica",
    "AAAAAC+Helvetica-Oblique",
    "AAAAAD+Helvetica-Bold"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.45,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#003366",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "left",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": {
    "src": "assets/acela.png",
    "align": "left"
  },
  "body": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 10,
    "color": "#003366"
  },
  "headings": {
    "h1": {
      "fontSizePx": 24,
      "weight": 700,
      "color": "#003366"
    },
    "h2": {
      "fontSizePx": 17,
      "weight": 700,
      "color": "#003366"
    },
    "h3": {
      "fontSizePx": 12,
      "weight": 600,
      "color": "#003366"
    }
  },
  "table": {
    "fontStack": "\"Helvetica\", Arial, Helvetica, sans-serif",
    "fontSizePx": 9,
    "lineHeight": 1.15,
    "border": "none",
    "borderColor": "#ffffff",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#003366",
    "zebra": true,
    "zebraColor": "#e6f2ff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "left"
  }
}

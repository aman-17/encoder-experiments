{
  "name": "tmpl_pgg",
  "source": "pgg.pdf",
  "sourceFonts": [
    "AAAAAB+ArialMT",
    "AAAAAC+Arial-BoldMT"
  ],
  "page": {
    "size": "Letter",
    "marginIn": 0.59,
    "columns": 1,
    "orientation": "portrait"
  },
  "decor": {
    "accent": "#000000",
    "tint": "none",
    "bodyAlign": "left",
    "lineHeight": 1.35,
    "letterSpacingPx": 0,
    "header": {
      "show": false
    },
    "footer": {
      "show": true,
      "rule": true,
      "align": "center",
      "pageNo": true
    },
    "captured": true
  },
  "watermark": null,
  "logo": null,
  "body": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 11,
    "color": "#000000"
  },
  "headings": {
    "h1": {
      "fontSizePx": 20,
      "weight": 700,
      "color": "#000000"
    },
    "h2": {
      "fontSizePx": 15,
      "weight": 700,
      "color": "#000000"
    },
    "h3": {
      "fontSizePx": 13,
      "weight": 600,
      "color": "#000000"
    }
  },
  "table": {
    "fontStack": "Arial, Helvetica, sans-serif",
    "fontSizePx": 10,
    "lineHeight": 1.15,
    "border": "none",
    "borderColor": "#000000",
    "borderWidthPx": 1,
    "headerStyle": "plain-bold",
    "headerBg": "transparent",
    "headerColor": "#000000",
    "zebra": false,
    "zebraColor": "#ffffff",
    "cellPadXPx": 4,
    "cellPadYPx": 2,
    "width": "100%",
    "numericAlign": "right"
  }
}
